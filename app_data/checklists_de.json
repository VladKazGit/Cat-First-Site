      {
        "heading": "Der erste Tag zu Hause",
        "items": [
          { "label": "Die Transportbox öffnen und das Kätzchen von selbst herauskommen lassen.", "note": null },
          { "label": "Den Standort der Toilette zeigen.", "note": null },
          { "label": "Die Näpfe mit Wasser und Futter zeigen.", "note": null },
          { "label": "Nicht sofort die ganze Wohnung zeigen — mit einem Zimmer beginnen und nach und nach mehr Raum freigeben, sobald das Kätzchen Interesse zeigt.", "note": null },
          { "label": "Es nicht ohne Grund hochheben.", "note": null },
          { "label": "Ihm die Möglichkeit geben, den Raum in Ruhe zu erkunden.", "note": null },
          { "label": "Am ersten Tag keine Gäste einladen.", "note": null }
        ]
      },
      {
        "heading": "Die ersten 7 Tage",
        "items": [
          { "label": "Mit dem gewohnten Futter füttern.", "note": null },
          { "label": "Die Streu nicht wechseln.", "note": null },
          { "label": "Einen festen Fütterungsrhythmus einhalten.", "note": null },
          { "label": "Täglich spielen, 10–20 Minuten pro Einheit.", "note": null },
          { "label": "Den Appetit im Auge behalten.", "note": null },
          { "label": "Die Trinkmenge im Auge behalten.", "note": null },
          { "label": "Kot und Urin im Auge behalten.", "note": null },
          { "label": "Nach und nach die übrigen Zimmer zeigen.", "note": null }
        ]
      },
      {
        "heading": "Tierarzt",
        "items": [
          { "label": "Einen ersten Untersuchungstermin vereinbaren.", "note": null },
          { "label": "Prüfen, ob ein Chip vorhanden ist.", "note": null },
          { "label": "Den Impfplan überprüfen.", "note": null },
          { "label": "Die Parasitenprophylaxe besprechen.", "note": null },
          { "label": "Sich nach der empfohlenen Ernährung erkundigen.", "note": null }
        ]
      },
      {
        "heading": "Wenn bereits andere Tiere im Haushalt leben",
        "items": [
          { "label": "Ein separates Zimmer vorbereiten.", "note": null },
          { "label": "Getrennte Näpfe.", "note": null },
          { "label": "Eine eigene Toilette.", "note": null },
          { "label": "Die Tiere nicht sofort aneinander gewöhnen.", "note": null },
          { "label": "Regelmäßig Gerüche zwischen den Tieren austauschen, zum Beispiel mit Gegenständen, die nach dem jeweils anderen riechen.", "note": null },
          { "label": "Die ersten Begegnungen schrittweise gestalten.", "note": null }
        ]
      },
      {
        "heading": "Nach der Eingewöhnung",
        "items": [
          { "label": "Ein passendes Futter auswählen.", "note": null },
          { "label": "Einen Fütterungsrhythmus festlegen.", "note": null },
          { "label": "Vertikalen Raum einrichten.", "note": null },
          { "label": "Weitere Kratzbäume anschaffen.", "note": null },
          { "label": "Sterilisation oder Kastration planen (je nach Alter und den Empfehlungen des Tierarztes).", "note": null },
          { "label": "Einen digitalen Heimtierausweis anlegen.", "note": null }
        ]
      }

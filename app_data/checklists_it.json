    "sections": [
      { "heading": "Prima dell'arrivo del gattino", "items": [] },
      {
        "heading": "Sicurezza in casa",
        "items": [
          { "label": "Installare reti di protezione «anti-fuga» alle finestre.", "note": null },
          { "label": "Mettere in sicurezza la modalità di ventilazione a ribalta delle finestre.", "note": null },
          { "label": "Mettere i cavi elettrici fuori portata.", "note": null },
          { "label": "Chiudere a chiave prodotti chimici e farmaci.", "note": null },
          { "label": "Eliminare le piante d'appartamento velenose.", "note": null },
          { "label": "Controllare le fessure strette dietro mobili ed elettrodomestici.", "note": null },
          { "label": "Fissare mobili alti e mensole.", "note": null },
          { "label": "Eliminare piccoli oggetti, fili, elastici e sacchetti.", "note": null },
          { "label": "Mettere in sicurezza i punti alti da cui il gattino potrebbe cadere.", "note": null }
        ]
      },

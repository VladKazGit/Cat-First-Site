          { "label": "Scegliere il cibo più adatto.", "note": null },
          { "label": "Definire un programma di alimentazione.", "note": null },
          { "label": "Organizzare spazi verticali.", "note": null },
          { "label": "Acquistare altri tiragraffi.", "note": null },
          { "label": "Pianificare la sterilizzazione o la castrazione (in base all'età e ai consigli del veterinario).", "note": null },
          { "label": "Creare un passaporto digitale del gatto.", "note": null }

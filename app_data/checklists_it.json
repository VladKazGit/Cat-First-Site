        ]
      },
      {
        "heading": "Il primo giorno a casa",
        "items": [
          { "label": "Aprire il trasportino e lasciare che il gattino esca da solo.", "note": null },
          { "label": "Mostrargli dove si trova la lettiera.", "note": null },
          { "label": "Mostrargli le ciotole di acqua e cibo.", "note": null },
          { "label": "Non fargli scoprire subito tutta la casa: iniziare da una sola stanza e ampliare lo spazio via via che il gattino mostra interesse.", "note": null },
          { "label": "Non prenderlo in braccio senza necessità.", "note": null },
          { "label": "Lasciargli esplorare lo spazio con calma.", "note": null },
          { "label": "Non invitare ospiti il primo giorno.", "note": null }
        ]
      },
      {
        "heading": "I primi 7 giorni",
        "items": [
          { "label": "Nutrirlo con il cibo a cui è abituato.", "note": null },
          { "label": "Non cambiare la lettiera abituale.", "note": null },
          { "label": "Rispettare gli orari dei pasti.", "note": null },
          { "label": "Giocare ogni giorno, per 10-20 minuti a sessione.", "note": null },
          { "label": "Monitorare l'appetito.", "note": null },
          { "label": "Monitorare quanto beve.", "note": null },
          { "label": "Controllare feci e urina.", "note": null },
          { "label": "Fargli scoprire gradualmente le altre stanze.", "note": null }
        ]
      },
      {
        "heading": "Veterinario",
        "items": [
          { "label": "Prenotare la prima visita.", "note": null },
          { "label": "Verificare la presenza del microchip.", "note": null },
          { "label": "Controllare il calendario vaccinale.", "note": null },
          { "label": "Parlare del trattamento antiparassitario.", "note": null },
          { "label": "Chiedere quale dieta è consigliata.", "note": null }
        ]
      },
      {
        "heading": "Se in casa ci sono altri animali",
        "items": [
          { "label": "Preparare una stanza separata.", "note": null },
          { "label": "Ciotole separate.", "note": null },
          { "label": "Lettiera separata.", "note": null },
          { "label": "Non far conoscere subito gli animali.", "note": null },
          { "label": "Scambiare regolarmente gli odori tra gli animali, usando oggetti impregnati del loro profumo.", "note": null },
          { "label": "Organizzare gradualmente i primi incontri.", "note": null }
        ]
      },
